erDiagram
    ROLE ||--o{ APP_USER : "role_id"
    ROLE ||--o{ ROLE_PERMISSION : "role_id"
    APP_USER ||--o| TOTP_ENROLLMENT : "user_id"
    APP_USER ||--o{ SESSION : "user_id"
    APP_USER |o--o{ AUDIT_ENTRY : "user_id (null for SYSTEM / ANONYMOUS)"
    BACKUP_FILE |o--o{ BACKUP_FILE : "base_backup_id (full base of a differential)"
    BACKUP_FILE ||--o{ RESTORE_PROCESS : "backup_id"
    APP_USER ||--o{ RESTORE_PROCESS : "requested_by"
    CUSTOMER ||--o{ COMMERCIAL_NOTE : "customer_id"
    APP_USER ||--o{ COMMERCIAL_NOTE : "author_id / updated_by"
    CUSTOMER |o--o{ QUOTATION : "customer_id"
    APP_USER |o--o{ QUOTATION : "approved_by"
    QUOTATION ||--|{ QUOTATION_ITEM : "quotation_id"
    PRODUCT ||--o{ QUOTATION_ITEM : "product_id"
    QUOTATION ||--o{ WORK_ORDER : "quotation_id (at most one non-cancelled O.T.)"
    CUSTOMER ||--o{ WORK_ORDER : "customer_id"
    APP_USER ||--o{ WORK_ORDER : "created_by"
    WORK_ORDER ||--|{ WORK_ORDER_ITEM : "work_order_id"
    PRODUCT ||--o{ WORK_ORDER_ITEM : "product_id"
    APP_USER ||--o{ EXPORT_BATCH : "created_by"
    WORK_ORDER ||--o| PROCESSING_QUEUE_ENTRY : "work_order_id"
    EXPORT_BATCH |o--|{ PROCESSING_QUEUE_ENTRY : "export_batch_id"
    APP_USER ||--o{ PRICE_IMPORT_BATCH : "uploaded_by"
    PRICE_IMPORT_BATCH ||--o{ HISTORICAL_PRICE_SAMPLE : "import_batch_id"
    PRODUCT |o--o{ HISTORICAL_PRICE_SAMPLE : "product_id (null until matched)"

    ROLE {
        integer id PK
        role_type type UK "SUPERADMIN, ADMIN, OPERATOR"
    }

    ROLE_PERMISSION {
        integer role_id PK, FK
        permission permission PK "USER_MANAGE, BACKUP_MANAGE, BACKUP_RESTORE, CATALOG_VIEW, CATALOG_EDIT, CUSTOMER_MANAGE, QUOTATION_MANAGE, EXPORT_QUEUE_MANAGE, WORK_ORDER_MANAGE, AUDIT_LOG_VIEW, PRICE_HISTORY_IMPORT"
    }

    APP_USER {
        uuid id PK
        integer role_id FK
        varchar full_name
        varchar email UK "Login key, read-only after creation"
        varchar job_title
        varchar password_hash "bcrypt, cost >= 12"
        account_status status "ACTIVE, INACTIVE"
        timestamptz last_access_at
        smallint failed_login_attempts "Default 0; reset on successful login"
        timestamptz last_failed_login_at
        timestamptz locked_until "NULL = not locked; now + 15 min after 3 consecutive failures"
    }

    TOTP_ENROLLMENT {
        uuid id PK
        uuid user_id FK, UK "Max one enrollment per user (0..1)"
        varchar secret "Encrypted at rest"
        bytea qr_code
        timestamptz issued_at
        timestamptz expires_at "issued_at + 5 min"
        enrollment_status status "PENDING, CONFIRMED, EXPIRED"
    }

    SESSION {
        uuid id PK
        uuid user_id FK
        varchar access_token_id "JWT jti"
        varchar refresh_token_id "JWT jti"
        timestamptz created_at
        timestamptz last_activity_at "Inactivity timeout 15 min"
        session_status status "ACTIVE, TERMINATED"
        termination_reason termination_reason "LOGOUT, INACTIVITY, NEW_LOGIN, ACCOUNT_DEACTIVATED"
    }

    AUDIT_ENTRY {
        uuid id PK "Insert-only: UPDATE/DELETE revoked + trigger"
        timestamptz occurred_at "Stored in UTC, shown in America/Bogota"
        actor_type actor_type "USER, SYSTEM, ANONYMOUS"
        uuid user_id FK "Nullable; CHECK actor_type = USER implies NOT NULL"
        varchar actor_label "e.g. backup-scheduler, virtual-assistant, attempted email"
        inet source_ip "Nullable for SYSTEM"
        audit_action action "CREATED, UPDATED, STATUS_CHANGED, APPROVED, REJECTED, CANCELLED, EXPORTED, DELETED, LOGIN, LOGIN_FAILED, ACCOUNT_LOCKED, LOGOUT, BACKUP, RESTORED"
        varchar entity_type
        varchar entity_id
        jsonb old_values "Nullable"
        jsonb new_values "Nullable"
        text reason "Required for reject, cancel, delete, price adjustment"
        operation_result result "SUCCESS, FAILURE"
        text details
    }

    BACKUP_FILE {
        uuid id PK
        varchar file_name
        timestamptz created_at
        double size_mb
        backup_type type "DAILY, WEEKLY, MONTHLY"
        backup_kind kind "FULL, DIFFERENTIAL"
        uuid base_backup_id FK "Full backup a differential depends on; NULL for FULL"
        varchar sha256_hash
        integrity_status integrity_status "VALID, CORRUPTED, NOT_VERIFIED"
        varchar storage_path
        boolean encrypted "Always true (AES-256)"
    }

    RESTORE_PROCESS {
        uuid id PK
        uuid backup_id FK
        uuid requested_by FK
        restore_status status "VERIFYING, VERIFIED, VERIFICATION_FAILED, CONFIRMED, COMPLETED, CANCELLED"
        boolean verification_success
        varchar verification_message
        timestamptz verified_at
        timestamptz started_at
        timestamptz finished_at
    }

    CUSTOMER {
        uuid id PK
        customer_type type "NATURAL_PERSON, LEGAL_ENTITY; read-only"
        varchar tax_id UK "ID number or NIT, read-only"
        varchar name "fullName or businessName"
        varchar address
        varchar primary_phone
        varchar email
        varchar commercial_contact
        customer_status status "ACTIVE, INACTIVE"
    }

    COMMERCIAL_NOTE {
        uuid id PK
        uuid customer_id FK
        uuid author_id FK
        uuid updated_by FK "Nullable; last editor (US 2.21.3)"
        text content
        timestamptz created_at
        timestamptz updated_at
    }

    PRODUCT {
        uuid id PK
        varchar code UK "Read-only"
        varchar name
        varchar unit_of_measure
        product_status status "ACTIVE, INACTIVE"
    }

    QUOTATION {
        uuid id PK
        varchar quotation_number UK "COT-YYYYMMDD-NNNNN, global consecutive"
        uuid customer_id FK "Nullable until a user links/registers the customer"
        timestamptz issued_at
        varchar requester_full_name "RequesterContact"
        varchar requester_email "RequesterContact"
        varchar requester_phone "RequesterContact"
        varchar requester_institution "Institution the furniture is for (optional)"
        varchar requester_tax_id "NIT of the institution (optional)"
        varchar access_key "Secret that authorizes the PDF and e-mail of the quotation"
        decimal estimated_total_min "PriceRange.min"
        decimal estimated_total_max "PriceRange.max"
        decimal final_total "Set on approval = sum(final_unit_price * quantity)"
        varchar currency "COP"
        varchar commercial_terms
        date valid_until
        date estimated_dispatch_date
        dispatch_date_source dispatch_date_source "SUGGESTED, MANUAL"
        quotation_status status "PENDING_REVIEW, MODIFIED, APPROVED, REJECTED"
        text rejection_reason "Required when rejecting"
        timestamptz approved_at
        uuid approved_by FK
        varchar approved_by_name "Snapshot of the approver's name"
    }

    QUOTATION_ITEM {
        uuid id PK
        uuid quotation_id FK
        uuid product_id FK
        varchar product_code "Snapshot"
        varchar description "Snapshot"
        integer quantity "CHECK > 0"
        decimal unit_price_min "Estimated range"
        decimal unit_price_max "Estimated range"
        decimal final_unit_price "Required to approve; feeds future estimations"
        varchar price_source "HISTORY or AI; empty when there is no estimate"
    }

    WORK_ORDER {
        uuid id PK
        varchar order_number UK "OT-YYYYMMDD-NNNNN, global consecutive, read-only"
        uuid quotation_id FK "Approved source quotation; NOT NULL; unique among non-cancelled O.T.s"
        uuid customer_id FK "Required; must be ACTIVE when generated"
        timestamptz quotation_approved_at "Snapshot: origin of the dispatch lead time"
        uuid created_by FK
        date agreed_delivery_date
        date actual_dispatch_date "Required when moving to RECONCILED (Conciliada); feeds the median"
        work_order_status status "PENDING, REGISTERED_IN_SIIGO, RECONCILED, CANCELLED"
        text cancellation_reason "Required when cancelling"
        timestamptz created_at
    }

    WORK_ORDER_ITEM {
        uuid id PK
        uuid work_order_id FK
        uuid product_id FK
        integer quantity "CHECK > 0"
    }

    EXPORT_BATCH {
        uuid id PK
        uuid created_by FK
        varchar file_name
        timestamptz created_at
    }

    PROCESSING_QUEUE_ENTRY {
        uuid id PK
        uuid work_order_id FK, UK "Work order to export"
        uuid export_batch_id FK "Null until exported"
        export_status export_status "PENDING_EXPORT, EXPORTED, WITHDRAWN (annulled before export)"
        timestamptz enqueued_at
        timestamptz withdrawn_at "Nullable"
        timestamptz exported_at "Nullable"
    }

    PRICE_IMPORT_BATCH {
        uuid id PK
        varchar file_name "Original file is deleted after extraction (Law 1581)"
        import_source source "WHATSAPP_TXT, WHATSAPP_SCREENSHOT"
        uuid uploaded_by FK
        timestamptz uploaded_at
        import_status status "PROCESSING, READY_FOR_REVIEW, COMPLETED, FAILED"
    }

    HISTORICAL_PRICE_SAMPLE {
        uuid id PK
        uuid import_batch_id FK
        uuid product_id FK "Nullable until the reviewer matches it to the catalog"
        varchar extracted_product_text "As read by the AI, without personal data"
        integer quantity "CHECK > 0"
        decimal unit_price
        varchar currency "COP"
        date observed_on "Date of the original message"
        sample_status status "PENDING_REVIEW, CONFIRMED, DISCARDED"
    }
