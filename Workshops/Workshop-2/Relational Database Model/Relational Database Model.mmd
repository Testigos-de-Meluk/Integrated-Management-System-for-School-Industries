erDiagram
    roles ||--o{ users : "role_id"
    users ||--o{ sessions : "user_id"
    users |o--o{ audit_logs : "user_id"
    backups ||--o{ backup_restore_tests : "backup_id"
    users ||--o{ backup_restore_tests : "tested_by"
    third_parties ||--o{ client_notes : "third_party_id"
    users ||--o{ client_notes : "created_by"
    products ||--o{ product_reference_prices : "product_id"
    products ||--o{ price_change_logs : "product_id"
    users ||--o{ price_change_logs : "changed_by"
    third_parties |o--o{ chatbot_contacts : "third_party_id"
    third_parties |o--o{ quotes : "third_party_id"
    chatbot_contacts |o--o{ quotes : "contact_id"
    users |o--o{ quotes : "created_by"
    users |o--o{ quotes : "reviewed_by"
    quotes ||--o{ quote_items : "quote_id"
    products ||--o{ quote_items : "product_id"
    quotes |o--o{ work_orders : "quote_id"
    third_parties ||--o{ work_orders : "third_party_id"
    users ||--o{ work_orders : "created_by"
    work_orders ||--o{ work_order_items : "work_order_id"
    products ||--o{ work_order_items : "product_id"
    work_orders ||--o{ delivery_history : "work_order_id"
    products ||--o{ delivery_history : "product_id"
    users ||--o{ siigo_export_batches : "generated_by"
    work_orders ||--o| siigo_export_queue : "work_order_id"
    siigo_export_batches |o--o{ siigo_export_queue : "batch_id"

    roles {
        integer id PK
        role_name name UK "super_admin, admin, operator"
        varchar description
    }

    users {
        integer id PK
        integer role_id FK
        varchar username UK
        varchar password_hash "bcrypt RNF-01-02"
        varchar full_name
        varchar email UK "Login key"
        varchar position "Employee job title"
        varchar totp_secret
        boolean totp_linked
        smallint failed_totp_attempts
        timestamp locked_until "Locked 15 min after 3 failures"
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }

    sessions {
        integer id PK
        integer user_id FK
        varchar refresh_token_hash
        varchar device_info
        varchar ip_address
        timestamp created_at
        timestamp last_activity_at "Timeout at 15 min"
        timestamp invalidated_at "Single session"
        boolean is_active
    }

    audit_logs {
        bigint id PK
        integer user_id FK
        varchar action
        varchar entity_name
        varchar entity_id
        jsonb details
        varchar ip_address
        timestamp created_at
    }

    backups {
        integer id PK
        backup_type type "daily, weekly, monthly"
        varchar file_path
        bigint size_bytes
        varchar sha256_hash "Integrity fingerprint"
        boolean is_encrypted
        integrity_status integrity_status "pending, valid, defective"
        timestamp verified_at
        timestamp created_at
        timestamp purged_at
    }

    backup_restore_tests {
        integer id PK
        integer backup_id FK
        integer tested_by FK
        timestamp started_at
        timestamp finished_at
        integrity_status result "pending, valid, defective"
        boolean restored_to_production
    }

    third_parties {
        integer id PK
        varchar nit UK
        varchar name
        third_party_type type "client, supplier, both"
        varchar email
        varchar phone
        varchar address
        decimal credit_limit
        decimal pending_balance "Accounts receivable"
        boolean is_active
        timestamp created_at
    }

    client_notes {
        integer id PK
        integer third_party_id FK
        integer created_by FK
        text note
        timestamp created_at
    }

    products {
        integer id PK
        varchar code UK
        varchar description
        varchar unit_of_measure
        decimal current_price "Suggested reference price"
        boolean is_active
        timestamp created_at
    }

    product_reference_prices {
        integer id PK
        integer product_id FK
        date valid_from
        date valid_to "Null = current"
        decimal min_price
        decimal max_price
        decimal suggested_price
        timestamp created_at
    }

    price_change_logs {
        bigint id PK
        integer product_id FK
        integer changed_by FK
        decimal previous_price
        decimal new_price
        varchar support_document_path
        timestamp changed_at
    }

    chatbot_contacts {
        integer id PK
        integer third_party_id FK
        varchar name
        varchar email
        varchar phone
        timestamp created_at
    }

    quotes {
        integer id PK
        varchar quote_number UK
        integer third_party_id FK
        integer contact_id FK
        quote_source source "whatsapp_guided_form, manual"
        quote_status status "preliminary, approved, rejected"
        decimal total
        date suggested_dispatch_date "Median of deliveries"
        varchar pdf_path
        text reject_reason "Required when rejecting"
        integer created_by FK
        integer reviewed_by FK
        timestamp reviewed_at
        timestamp created_at
    }

    quote_items {
        integer id PK
        integer quote_id FK
        integer product_id FK
        decimal quantity
        decimal unit_price "Frozen price"
        decimal subtotal
    }

    work_orders {
        integer id PK
        varchar wo_number UK
        integer quote_id FK "Null = manual work order"
        integer third_party_id FK
        date agreed_date
        work_order_status status "pending, registered_in_siigo, reconciled, voided"
        text void_reason "Required when voiding"
        integer created_by FK
        timestamp created_at
        timestamp updated_at
    }

    work_order_items {
        integer id PK
        integer work_order_id FK
        integer product_id FK
        decimal quantity
        decimal unit_price
        decimal subtotal
    }

    delivery_history {
        integer id PK
        integer work_order_id FK
        integer product_id FK
        decimal quantity
        date order_date
        date delivery_date
        integer delivery_days
    }

    siigo_export_batches {
        integer id PK
        integer generated_by FK
        varchar file_path
        integer order_count
        timestamp generated_at
    }

    siigo_export_queue {
        integer id PK
        integer work_order_id FK, UK
        integer batch_id FK
        timestamp queued_at
        timestamp exported_at
    }