erDiagram
    ROLE ||--o{ USER_ACCOUNT : "assigns"
    USER_ACCOUNT ||--o| TOTP_ENROLLMENT : "enrolls"
    USER_ACCOUNT ||--o{ SESSION : "opens"
    USER_ACCOUNT ||--o{ AUDIT_ENTRY : "generates"
    USER_ACCOUNT ||--o{ PRICE_CHANGE_AUDIT : "performs"
    USER_ACCOUNT ||--o{ COMMERCIAL_NOTE : "writes"
    USER_ACCOUNT ||--o{ EXPORT_BATCH : "creates"

    BACKUP_FILE ||--o{ RESTORE_PROCESS : "is used in"
    USER_ACCOUNT ||--o{ RESTORE_PROCESS : "executes"

    PRODUCT ||--o{ PRICE_CHANGE_AUDIT : "logs"
    PRODUCT ||--o{ QUOTATION_ITEM : "is quoted in"
    PRODUCT ||--o{ WORK_ORDER_ITEM : "is ordered in"

    CUSTOMER ||--o{ QUOTATION : "requests"
    CUSTOMER ||--o{ WORK_ORDER : "orders"
    CUSTOMER ||--o{ COMMERCIAL_NOTE : "has"

    QUOTATION ||--|{ QUOTATION_ITEM : "contains"
    WORK_ORDER ||--|{ WORK_ORDER_ITEM : "contains"

    QUOTATION ||--o| PROCESSING_QUEUE_ENTRY : "is enqueued as"
    EXPORT_BATCH ||--|{ PROCESSING_QUEUE_ENTRY : "groups"

    ROLE {
        int id PK
        string type "SUPERADMIN, ADMIN, OPERATOR"
        string permissions
    }

    USER_ACCOUNT {
        uuid id PK
        string full_name
        string email UK
        string password_hash
        string status "ACTIVE, INACTIVE, BLOCKED"
        int role_id FK
    }

    TOTP_ENROLLMENT {
        int id PK
        uuid user_id FK, UK
        string secret
        datetime expires_at
    }

    SESSION {
        uuid id PK
        uuid user_id FK
        string status "ACTIVE, CLOSED, EXPIRED"
        datetime last_activity_at
    }

    AUDIT_ENTRY {
        int id PK
        uuid user_id FK
        string action
        string entity_id
        datetime created_at
    }

    BACKUP_FILE {
        int id PK
        string type "DAILY, WEEKLY, MONTHLY"
        string sha256_hash
        string integrity_status "OK, CORRUPT"
        decimal size_mb
        datetime created_at
    }

    RESTORE_PROCESS {
        int id PK
        int backup_id FK
        uuid executed_by FK
        string status "TEST, SUCCESSFUL, FAILED, CONFIRMED"
        string verification
    }

    PRODUCT {
        int id PK
        string code UK
        string name
        string unit_of_measure
        decimal official_price
        string status "ACTIVE, INACTIVE"
    }

    PRICE_CHANGE_AUDIT {
        int id PK
        int product_id FK
        uuid user_id FK
        decimal previous_price
        decimal new_price
        string support_document
        datetime changed_at
    }

    CUSTOMER {
        int id PK
        string tax_id UK "NIT or document"
        string customer_type "NATURAL, LEGAL"
        string full_name "natural person"
        string business_name "legal person"
        string status "ACTIVE, INACTIVE"
    }

    COMMERCIAL_NOTE {
        int id PK
        int customer_id FK
        uuid author_id FK
        string content
        datetime created_at
    }

    QUOTATION {
        int id PK
        int customer_id FK "nullable"
        string status "PENDING, MODIFIED, APPROVED, REJECTED"
        decimal total_amount
        datetime created_at
    }

    QUOTATION_ITEM {
        int id PK
        int quotation_id FK
        int product_id FK
        int quantity
        decimal unit_price
    }

    WORK_ORDER {
        int id PK
        bigint order_number UK
        int customer_id FK
        string status "PENDING, REGISTERED_IN_SIIGO, RECONCILED"
        date agreed_delivery_date
    }

    WORK_ORDER_ITEM {
        int id PK
        int work_order_id FK
        int product_id FK
        int quantity
    }

    EXPORT_BATCH {
        int id PK
        string file_name
        datetime created_at
    }

    PROCESSING_QUEUE_ENTRY {
        int id PK
        int quotation_id FK, UK
        int export_batch_id FK "nullable until exported"
        string export_status "PENDING, EXPORTED"
        datetime enqueued_at
    }
