<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <bpmn:dataStore id="DataStore_Catalog" name="Product catalog (no prices)" />
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_Empresa" name="Company" processRef="Proc_Empresa" />
    <bpmn:textAnnotation id="TextAnnotation_1fsn4c2">
      <bpmn:text>The Operator's functions can also be performed by the Administrator and the Superadministrator.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_00yqt0g" associationDirection="None" sourceRef="TextAnnotation_1fsn4c2" targetRef="Pool_Empresa" />
    <bpmn:textAnnotation id="ann5">
      <bpmn:text>The Administrator's functions can also be performed by the Superadministrator</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1k3fltg" associationDirection="None" sourceRef="ann5" targetRef="Pool_Empresa" />
    <bpmn:association id="Association_02i2omm" associationDirection="None" sourceRef="ann5" targetRef="Pool_Empresa" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Empresa" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Op" name="Operador">
        <bpmn:flowNodeRef>pc1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_pc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sys" name="System">
        <bpmn:flowNodeRef>ds_c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ds_c2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ds_c3</bpmn:flowNodeRef>
