        <bpmn:flowNodeRef>end_st</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Adm" name="Administrador">
        <bpmn:flowNodeRef>pm_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sr_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gm_e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ed1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gm_r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r1_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_p1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_p2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sr_e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_169yxmj</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="pm_s" name="Catalog operation requested">
      <bpmn:outgoing>f133</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="gc" name="Catalog operation?">
      <bpmn:incoming>f133</bpmn:incoming>
      <bpmn:outgoing>f134</bpmn:outgoing>
      <bpmn:outgoing>f135</bpmn:outgoing>
      <bpmn:outgoing>f136</bpmn:outgoing>
      <bpmn:outgoing>f137</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:dataStoreReference id="ds_catr" name="Product catalog" dataStoreRef="DataStore_Catalog" />
    <bpmn:userTask id="pc1" name="Search and filter the product catalog">
      <bpmn:documentation>RF-02-01. Operador has read-only access. Shows code, name, unit of measure and status (no prices).</bpmn:documentation>
      <bpmn:incoming>f137</bpmn:incoming>
      <bpmn:outgoing>f156</bpmn:outgoing>
      <bpmn:property id="Property_01xgcpn" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="da8">
        <bpmn:sourceRef>ds_catr</bpmn:sourceRef>
        <bpmn:targetRef>Property_01xgcpn</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:endEvent id="end_pc" name="Catalog consulted">
      <bpmn:incoming>f156</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="sr_s" name="Select the product from the catalog">
      <bpmn:documentation>RF-02-01: search and filter the catalog.</bpmn:documentation>
      <bpmn:incoming>f136</bpmn:incoming>
      <bpmn:outgoing>f138</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gm_e">
      <bpmn:incoming>f141</bpmn:incoming>
      <bpmn:incoming>f197</bpmn:incoming>
      <bpmn:outgoing>f142</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ed1" name="Edit name or unit of measure (code is read-only)">
      <bpmn:documentation>RF-02-03. Code cannot be modified.</bpmn:documentation>
      <bpmn:incoming>f142</bpmn:incoming>
      <bpmn:outgoing>f143</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gm_r">
      <bpmn:incoming>f134</bpmn:incoming>
      <bpmn:incoming>f199</bpmn:incoming>
      <bpmn:outgoing>f149</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="r1_4" name="Enter code, name and unit of measure">
      <bpmn:documentation>RF-02-02. Administrador / Superadministrador only. NO price field: there are no official prices.</bpmn:documentation>
      <bpmn:incoming>f149</bpmn:incoming>
      <bpmn:outgoing>f150</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="s_ve_4" name="Validate fields">
      <bpmn:documentation>RF-02-03</bpmn:documentation>
      <bpmn:incoming>f143</bpmn:incoming>
      <bpmn:outgoing>f144</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gv_e_4" name="Fields valid?">
      <bpmn:incoming>f144</bpmn:incoming>
      <bpmn:outgoing>f145</bpmn:outgoing>
      <bpmn:outgoing>f147</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="s_ed_4" name="Save changes and log">
      <bpmn:documentation>RF-02-03</bpmn:documentation>
      <bpmn:incoming>f145</bpmn:incoming>
      <bpmn:outgoing>f146</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="da6">
        <bpmn:targetRef>ds_c2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_ed" name="Product updated">
      <bpmn:incoming>f146</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="n_e_4" name="Tell the user&#10;which fields are missing or invalid">
      <bpmn:incoming>f147</bpmn:incoming>
      <bpmn:outgoing>f196</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="s_vr" name="Validate fields and code uniqueness">
      <bpmn:documentation>RF-02-02: the code must not already exist in the catalog.</bpmn:documentation>
      <bpmn:incoming>f150</bpmn:incoming>
      <bpmn:outgoing>f151</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gv_r" name="Data valid and code unique?">
      <bpmn:incoming>f151</bpmn:incoming>
      <bpmn:outgoing>f152</bpmn:outgoing>
      <bpmn:outgoing>f154</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="s_sv" name="Save the product as &#34;Activo&#34; and log">
      <bpmn:documentation>RF-02-02: available immediately for query and quotes.</bpmn:documentation>
      <bpmn:incoming>f152</bpmn:incoming>
      <bpmn:outgoing>f153</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="da7">
        <bpmn:targetRef>ds_c3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_sv" name="Product registered">
      <bpmn:incoming>f153</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="n_r" name="Tell the user&#10;what is missing, invalid or duplicated">
      <bpmn:documentation>"El código de producto ya se encuentra registrado en el catálogo" for duplicates; the user can correct and retry.</bpmn:documentation>
      <bpmn:incoming>f154</bpmn:incoming>
      <bpmn:outgoing>f198</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:dataStoreReference id="ds_c2" name="Product catalog" dataStoreRef="DataStore_Catalog" />
    <bpmn:dataStoreReference id="ds_c3" name="Product catalog" dataStoreRef="DataStore_Catalog" />
    <bpmn:intermediateCatchEvent id="ev_p1" name="Administrador receives: missing or invalid fields">
      <bpmn:incoming>f196</bpmn:incoming>
      <bpmn:outgoing>f197</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_p1_med" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ev_p2" name="Administrador receives: missing, invalid or duplicated data">
      <bpmn:incoming>f198</bpmn:incoming>
      <bpmn:outgoing>f199</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_p2_med" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="sr_e" name="Select the product from the catalog">
      <bpmn:documentation>RF-02-01</bpmn:documentation>
      <bpmn:incoming>f135</bpmn:incoming>
      <bpmn:outgoing>f141</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_169yxmj" name="User active o deactive the product?">
      <bpmn:incoming>f138</bpmn:incoming>
      <bpmn:outgoing>Flow_05192mk</bpmn:outgoing>
      <bpmn:outgoing>Flow_1k83oz9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_19vvrjp" name="Update status;&#10;make the product available in new quotes">
      <bpmn:documentation>RF-02-04: history is kept.</bpmn:documentation>
      <bpmn:incoming>Flow_1k83oz9</bpmn:incoming>
      <bpmn:outgoing>Flow_0b1fmac</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_04q0i66">
        <bpmn:targetRef>ds_c1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="s_st" name="Update status;&#10;block the product in new quotes">
      <bpmn:documentation>RF-02-04: history is kept.</bpmn:documentation>
      <bpmn:incoming>Flow_05192mk</bpmn:incoming>
      <bpmn:outgoing>f140</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="da5">
        <bpmn:targetRef>ds_c1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="ds_c1" name="Product catalog" dataStoreRef="DataStore_Catalog" />
    <bpmn:endEvent id="end_st" name="Status updated">
      <bpmn:incoming>f140</bpmn:incoming>
      <bpmn:incoming>Flow_0b1fmac</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f133" sourceRef="pm_s" targetRef="gc" />
    <bpmn:sequenceFlow id="f134" name="Register" sourceRef="gc" targetRef="gm_r" />
    <bpmn:sequenceFlow id="f135" name="Edit" sourceRef="gc" targetRef="sr_e" />
