<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <bpmn:dataStore id="DataStore_Sessions" name="Active sessions" />
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_UserW" name="User" processRef="Proc_Cliente" />
    <bpmn:participant id="Pool_Empresa" name="Platform" processRef="Proc_Empresa" />
    <bpmn:messageFlow id="m332" sourceRef="s_u1" targetRef="ss_ea" />
    <bpmn:messageFlow id="m333" sourceRef="s_u2" targetRef="ss_en" />
    <bpmn:messageFlow id="m334" sourceRef="ss_4" targetRef="s_eexp" />
    <bpmn:messageFlow id="m335" sourceRef="ss_6" targetRef="s_enew" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Cliente" isExecutable="false">
    <bpmn:startEvent id="s_u0" name="User authenticated">
      <bpmn:outgoing>f309</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="s_gm">
      <bpmn:incoming>f309</bpmn:incoming>
      <bpmn:incoming>f312</bpmn:incoming>
      <bpmn:outgoing>f310</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="s_gx" name="User action?">
      <bpmn:incoming>f310</bpmn:incoming>
      <bpmn:outgoing>f311</bpmn:outgoing>
      <bpmn:outgoing>f313</bpmn:outgoing>
      <bpmn:outgoing>f314</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="s_eexp" name="Redirected: session expired">
      <bpmn:incoming>f313</bpmn:incoming>
      <bpmn:outgoing>f316</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_eexp_med" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="s_uend1" name="Back at the login screen (inactivity)">
      <bpmn:incoming>f316</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="s_u2" name="Log in on another device">
      <bpmn:documentation>RF-01-05</bpmn:documentation>
      <bpmn:incoming>f314</bpmn:incoming>
      <bpmn:outgoing>f315</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="s_u1" name="Use the platform (clicks and scrolls)">
      <bpmn:documentation>RF-01-06: any click or scroll counts as activity and restarts the inactivity period.</bpmn:documentation>
      <bpmn:incoming>f311</bpmn:incoming>
      <bpmn:outgoing>f312</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="s_enew" name="Redirected: new login on another device">
      <bpmn:incoming>f315</bpmn:incoming>
      <bpmn:outgoing>f317</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_enew_med" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="s_uend2" name="Back at the login screen (new login)">
      <bpmn:incoming>f317</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f309" sourceRef="s_u0" targetRef="s_gm" />
    <bpmn:sequenceFlow id="f312" sourceRef="s_u1" targetRef="s_gm" />
    <bpmn:sequenceFlow id="f310" sourceRef="s_gm" targetRef="s_gx" />
    <bpmn:sequenceFlow id="f311" name="Interacts" sourceRef="s_gx" targetRef="s_u1" />
    <bpmn:sequenceFlow id="f313" name="Stops interacting" sourceRef="s_gx" targetRef="s_eexp" />
    <bpmn:sequenceFlow id="f314" name="Logs in on another device" sourceRef="s_gx" targetRef="s_u2" />
    <bpmn:sequenceFlow id="f316" sourceRef="s_eexp" targetRef="s_uend1" />
    <bpmn:sequenceFlow id="f315" sourceRef="s_u2" targetRef="s_enew" />
    <bpmn:sequenceFlow id="f317" sourceRef="s_enew" targetRef="s_uend2" />
  </bpmn:process>
  <bpmn:process id="Proc_Empresa" isExecutable="false">
    <bpmn:startEvent id="ss_s" name="User authenticated (new login)">
      <bpmn:documentation>Triggered by a successful login (M1_01).</bpmn:documentation>
      <bpmn:outgoing>f318</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ss_1" name="Invalidate any previous active session of the account">
      <bpmn:documentation>RF-01-05, HU 1.5: only one active session per account.</bpmn:documentation>
      <bpmn:incoming>f318</bpmn:incoming>
      <bpmn:outgoing>f319</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="dss1">
        <bpmn:targetRef>ds_sess</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ss_2" name="Register the new active session">
      <bpmn:documentation>RF-01-05</bpmn:documentation>
      <bpmn:incoming>f319</bpmn:incoming>
      <bpmn:outgoing>f320</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="dss2">
        <bpmn:targetRef>ds_sess</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ss_gm">
      <bpmn:incoming>f320</bpmn:incoming>
      <bpmn:incoming>f325</bpmn:incoming>
      <bpmn:outgoing>f321</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ss_3" name="Invalidate the session tokens">
      <bpmn:documentation>RF-01-06</bpmn:documentation>
      <bpmn:incoming>f326</bpmn:incoming>
      <bpmn:outgoing>f327</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="ss_4" name="Redirect to&#10;login: Session expired due to inactivity">
      <bpmn:documentation>RF-01-06</bpmn:documentation>
      <bpmn:incoming>f327</bpmn:incoming>
      <bpmn:outgoing>f328</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="ss_end1" name="Session closed by inactivity">
      <bpmn:incoming>f328</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="ss_en" name="New login on another device">
      <bpmn:documentation>RF-01-05: a successful new login invalidates the previous session.</bpmn:documentation>
      <bpmn:incoming>f324</bpmn:incoming>
      <bpmn:outgoing>f329</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ss_en_med" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="ss_5" name="Invalidate this session">
      <bpmn:documentation>RF-01-05</bpmn:documentation>
      <bpmn:incoming>f329</bpmn:incoming>
      <bpmn:outgoing>f330</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="ss_6" name="Redirect to&#10;login: new login on another device">
      <bpmn:documentation>RF-01-05, HU 1.5. Message: "Su sesión ha sido cerrada debido a un nuevo inicio de sesión en otro dispositivo".</bpmn:documentation>
      <bpmn:incoming>f330</bpmn:incoming>
      <bpmn:outgoing>f331</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="ss_end2" name="Session closed by new login">
      <bpmn:incoming>f331</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="ds_sess" name="Active sessions" dataStoreRef="DataStore_Sessions" />
    <bpmn:eventBasedGateway id="ss_eb">
      <bpmn:incoming>f321</bpmn:incoming>
      <bpmn:outgoing>f322</bpmn:outgoing>
      <bpmn:outgoing>f323</bpmn:outgoing>
      <bpmn:outgoing>f324</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="ss_ea" name="User activity (click or scroll)">
      <bpmn:documentation>RF-01-06: any click or scroll restarts the inactivity period.</bpmn:documentation>
      <bpmn:incoming>f322</bpmn:incoming>
      <bpmn:outgoing>f325</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ss_ea_med" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ss_et" name="15 minutes without activity">
      <bpmn:documentation>RF-01-06, HU 1.6: continuous 15-minute inactivity.</bpmn:documentation>
      <bpmn:incoming>f323</bpmn:incoming>
      <bpmn:outgoing>f326</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ss_et_ted">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="f318" sourceRef="ss_s" targetRef="ss_1" />
