      <bpmndi:BPMNShape id="bk_be_di" bpmnElement="bk_be">
        <dc:Bounds x="802" y="452" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f352_di" bpmnElement="f352">
        <di:waypoint x="318" y="360" />
