          <dc:Bounds x="1305" y="508" width="110" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ds_bi2_di" bpmnElement="ds_bi2">
        <dc:Bounds x="1495" y="455" width="50" height="50" />
