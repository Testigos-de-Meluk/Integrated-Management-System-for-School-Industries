        <di:waypoint x="885" y="580" />
        <di:waypoint x="972" y="580" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Pool_Admins_di" bpmnElement="Pool_Admins" isHorizontal="true">
        <dc:Bounds x="160" y="700" width="1600" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="dbk1_di" bpmnElement="dbk1">
        <di:waypoint x="1360" y="398" />
        <di:waypoint x="1360" y="455" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="dbk2_di" bpmnElement="dbk2">
        <di:waypoint x="1520" y="398" />
        <di:waypoint x="1520" y="455" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="m363_di" bpmnElement="m363">
