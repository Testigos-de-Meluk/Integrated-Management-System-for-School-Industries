<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <bpmn:dataStore id="DataStore_Queue" name="Processing queue" />
  <bpmn:error id="Error_Export" name="Flat file generation failed" errorCode="EXPORT_FAILED" />
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_Empresa" name="Company" processRef="Proc_Empresa" />
    <bpmn:participant id="Pool_Siigo" name="Siigo Pyme (accounting system)" />
    <bpmn:messageFlow id="m94" sourceRef="o4" targetRef="Pool_Siigo" />
    <bpmn:textAnnotation id="TextAnnotation_1aoryhq">
      <bpmn:text>The Administrator and Superadministrator can also perform these tasks</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0j12x1g" associationDirection="None" sourceRef="TextAnnotation_1aoryhq" targetRef="Pool_Empresa" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Empresa" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Op" name="Operador">
        <bpmn:flowNodeRef>p3s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>go1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>u_err</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_x</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_o2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sys" name="System">
        <bpmn:flowNodeRef>ds_q2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ds_q3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>nx1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gm_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>be</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p3s" name="Approved orders pending export">
      <bpmn:outgoing>f79</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="o1" name="Open the queue of approved orders">
      <bpmn:documentation>RF-02-18, HU 2.31: the queue is shown by default; filters (HU 2.32) are optional.</bpmn:documentation>
      <bpmn:incoming>f79</bpmn:incoming>
      <bpmn:outgoing>f80</bpmn:outgoing>
      <bpmn:property id="Property_1eetma1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="da4">
        <bpmn:sourceRef>ds_q2</bpmn:sourceRef>
        <bpmn:targetRef>Property_1eetma1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="o2" name="Select orders for the batch">
      <bpmn:documentation>HU 2.33</bpmn:documentation>
      <bpmn:incoming>f80</bpmn:incoming>
      <bpmn:incoming>f187</bpmn:incoming>
      <bpmn:outgoing>f81</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="go1" name="At least one order selected?">
      <bpmn:incoming>f81</bpmn:incoming>
      <bpmn:outgoing>f82</bpmn:outgoing>
      <bpmn:outgoing>f84</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="u_err" name="Review the generation error">
      <bpmn:documentation>HU 2.34.7: the operator sees the error; the orders remain in the queue.</bpmn:documentation>
      <bpmn:incoming>f88</bpmn:incoming>
      <bpmn:outgoing>f89</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gr" name="Retry the export?">
      <bpmn:incoming>f89</bpmn:incoming>
      <bpmn:outgoing>f90</bpmn:outgoing>
      <bpmn:outgoing>f91</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_x" name="Export cancelled (orders stay in the queue)">
      <bpmn:incoming>f90</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="nx1" name="Tell the&#10;operator to select at least one order">
      <bpmn:documentation>HU 2.33: the system indicates that at least one order must be selected.</bpmn:documentation>
      <bpmn:incoming>f82</bpmn:incoming>
      <bpmn:outgoing>f186</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:dataStoreReference id="ds_q2" name="Processing queue" dataStoreRef="DataStore_Queue" />
    <bpmn:intermediateCatchEvent id="ev_o2" name="Operador receives: select at least one order">
      <bpmn:incoming>f186</bpmn:incoming>
      <bpmn:outgoing>f187</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_o2_med" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="o4" name="Load the file into&#10;Siigo Pyme (outside the system)">
      <bpmn:documentation>HU 2.34.4: the system only generates the file; the operator loads it manually. The message flow represents the file handover to Siigo Pyme.</bpmn:documentation>
      <bpmn:incoming>f92</bpmn:incoming>
      <bpmn:outgoing>f93</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="o_end" name="Orders loaded in Siigo">
      <bpmn:incoming>f93</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="o3" name="Download the flat file">
      <bpmn:documentation>HU 2.34.3</bpmn:documentation>
      <bpmn:incoming>f87</bpmn:incoming>
      <bpmn:outgoing>f92</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="s13" name="Mark orders as exported and log (date, time, user and batch)">
      <bpmn:documentation>RF-02-19, HU 2.34.5-2.34.6: exported orders leave the active queue to avoid duplicates.</bpmn:documentation>
      <bpmn:incoming>f86</bpmn:incoming>
      <bpmn:outgoing>f87</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="da14">
        <bpmn:targetRef>ds_q3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="ds_q3" name="Processing queue" dataStoreRef="DataStore_Queue" />
    <bpmn:serviceTask id="s11" name="Generate flat file in Siigo Pyme format">
      <bpmn:documentation>RF-02-19, HU 2.34.2</bpmn:documentation>
      <bpmn:incoming>f85</bpmn:incoming>
      <bpmn:outgoing>f86</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gm_s">
      <bpmn:incoming>f84</bpmn:incoming>
      <bpmn:incoming>f91</bpmn:incoming>
      <bpmn:outgoing>f85</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:boundaryEvent id="be" attachedToRef="s11">
      <bpmn:documentation>Error caught here: file generation fails (HU 2.34.7). Handled by the operator review and retry decision.</bpmn:documentation>
      <bpmn:outgoing>f88</bpmn:outgoing>
      <bpmn:errorEventDefinition id="be_eed" errorRef="Error_Export" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="f79" sourceRef="p3s" targetRef="o1" />
    <bpmn:sequenceFlow id="f80" sourceRef="o1" targetRef="o2" />
    <bpmn:sequenceFlow id="f187" sourceRef="ev_o2" targetRef="o2" />
    <bpmn:sequenceFlow id="f81" sourceRef="o2" targetRef="go1" />
    <bpmn:sequenceFlow id="f82" name="No" sourceRef="go1" targetRef="nx1" />
    <bpmn:sequenceFlow id="f84" name="Yes" sourceRef="go1" targetRef="gm_s" />
    <bpmn:sequenceFlow id="f88" name="Generation fails" sourceRef="be" targetRef="u_err" />
    <bpmn:sequenceFlow id="f89" sourceRef="u_err" targetRef="gr" />
    <bpmn:sequenceFlow id="f90" name="No" sourceRef="gr" targetRef="end_x" />
    <bpmn:sequenceFlow id="f91" name="Yes" sourceRef="gr" targetRef="gm_s" />
    <bpmn:sequenceFlow id="f186" sourceRef="nx1" targetRef="ev_o2" />
    <bpmn:sequenceFlow id="f92" sourceRef="o3" targetRef="o4" />
    <bpmn:sequenceFlow id="f93" sourceRef="o4" targetRef="o_end" />
    <bpmn:sequenceFlow id="f87" sourceRef="s13" targetRef="o3" />
    <bpmn:sequenceFlow id="f86" sourceRef="s11" targetRef="s13" />
    <bpmn:sequenceFlow id="f85" sourceRef="gm_s" targetRef="s11" />
  </bpmn:process>
