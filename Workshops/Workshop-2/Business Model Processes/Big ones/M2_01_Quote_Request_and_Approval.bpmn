<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <bpmn:dataStore id="DataStore_Catalog" name="Product catalog (no prices)" />
  <bpmn:dataStore id="DataStore_Hist" name="Quotes (price history)" />
  <bpmn:dataStore id="DataStore_Queue" name="Processing queue" />
  <bpmn:dataStore id="DataStore_WhatsApp" name="WhatsApp conversations (initial price data)" />
  <bpmn:category id="Category_Phases">
    <bpmn:categoryValue id="CV_G1" value="1. Quote request via chatbot" />
    <bpmn:categoryValue id="CV_G2" value="2. Quote review and decision" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_Cliente" name="Potential Customer" processRef="Proc_Cliente" />
    <bpmn:participant id="Pool_Empresa" name="Company" processRef="Proc_Empresa" />
    <bpmn:messageFlow id="m20" sourceRef="c1" targetRef="cs" />
    <bpmn:messageFlow id="m21" sourceRef="b1a" targetRef="ce1" />
    <bpmn:messageFlow id="m22" sourceRef="c2" targetRef="e1" />
    <bpmn:messageFlow id="m23" sourceRef="r1" targetRef="ce2" />
    <bpmn:messageFlow id="m24" sourceRef="b2a" targetRef="ce2" />
    <bpmn:messageFlow id="m25" sourceRef="c3" targetRef="e2" />
    <bpmn:messageFlow id="m26" sourceRef="r2" targetRef="ce3" />
    <bpmn:messageFlow id="m27" sourceRef="b4" targetRef="ce3" />
    <bpmn:messageFlow id="m28" sourceRef="c5" targetRef="e_d" />
    <bpmn:messageFlow id="m29" sourceRef="b5" targetRef="ce5" />
    <bpmn:messageFlow id="m30" sourceRef="b6" targetRef="ce5" />
    <bpmn:messageFlow id="m77" sourceRef="e_t2" targetRef="c_ko" />
    <bpmn:messageFlow id="m78" sourceRef="e_t1" targetRef="c_ok" />
    <bpmn:group id="G1" categoryValueRef="CV_G1" />
    <bpmn:group id="G2" categoryValueRef="CV_G2" />
    <bpmn:textAnnotation id="ann2">
      <bpmn:text>Cannot be approved without final prices and a dispatch date.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1knjf03">
      <bpmn:text>The Administrator's functions can also be performed by the Superadministrator.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1ac5h37" associationDirection="None" sourceRef="TextAnnotation_1knjf03" targetRef="Pool_Empresa" />
    <bpmn:association id="ann2_as" sourceRef="ga1" targetRef="ann2" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Cliente" isExecutable="false">
    <bpmn:startEvent id="c_start" name="Needs a quote">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="ce2" name="Chatbot replies">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ce2_med" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="gx1" name="Details accepted?">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="ce3" name="Chatbot replies">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ce3_med" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="gx2" name="Products accepted?">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="c5" name="Choose download or email">
      <bpmn:documentation>HU 2.10.2</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="ce5" name="Quote PDF received">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ce5_med" />
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="c_ebg">
      <bpmn:categoryValueRef>CV_G2</bpmn:categoryValueRef>
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="c_ok" name="Receives official quote">
      <bpmn:categoryValueRef>CV_G2</bpmn:categoryValueRef>
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="c_ok_med" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c_ko" name="Receives rejection email">
      <bpmn:categoryValueRef>CV_G2</bpmn:categoryValueRef>
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="c_ko_med" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="c_end_ok" name="Official quote received">
      <bpmn:categoryValueRef>CV_G2</bpmn:categoryValueRef>
      <bpmn:incoming>f18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="c_end_ko" name="Request rejected">
      <bpmn:categoryValueRef>CV_G2</bpmn:categoryValueRef>
      <bpmn:incoming>f19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="c1" name="Open the chatbot and request a quote">
      <bpmn:documentation>Customer enters the public web portal and opens the chatbot (RF-02-06).</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="ce1" name="Chatbot asks for contact details">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ce1_med" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="gm_c2">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="c2" name="Enter name, email and phone">
      <bpmn:documentation>HU 2.9.1</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gm_c3">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="c3" name="Specify required products and quantities">
      <bpmn:documentation>HU 2.9.3</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="f1" sourceRef="c_start" targetRef="c1">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f5" sourceRef="c2" targetRef="ce2">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f6" sourceRef="ce2" targetRef="gx1">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f7" name="Yes" sourceRef="gx1" targetRef="gm_c3">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f8" name="No" sourceRef="gx1" targetRef="gm_c2">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f10" sourceRef="c3" targetRef="ce3">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f11" sourceRef="ce3" targetRef="gx2">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f12" name="No" sourceRef="gx2" targetRef="gm_c3">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f13" name="Yes" sourceRef="gx2" targetRef="c5">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f14" sourceRef="c5" targetRef="ce5">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f15" sourceRef="ce5" targetRef="c_ebg" />
    <bpmn:sequenceFlow id="f16" sourceRef="c_ebg" targetRef="c_ok">
      <bpmn:categoryValueRef>CV_G2</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f17" sourceRef="c_ebg" targetRef="c_ko">
      <bpmn:categoryValueRef>CV_G2</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f18" sourceRef="c_ok" targetRef="c_end_ok">
      <bpmn:categoryValueRef>CV_G2</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f19" sourceRef="c_ko" targetRef="c_end_ko">
      <bpmn:categoryValueRef>CV_G2</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f2" sourceRef="c1" targetRef="ce1">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f3" sourceRef="ce1" targetRef="gm_c2">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f4" sourceRef="gm_c2" targetRef="c2">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f9" sourceRef="gm_c3" targetRef="c3">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="Proc_Empresa" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Sys" name="System">
        <bpmn:flowNodeRef>ds1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ds_wa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ds2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ds_q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ds_qa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ds_qb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s1w</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gs1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gm0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ko</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Adm" name="Administrador">
        <bpmn:flowNodeRef>ds_qr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ds_cat1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ga1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Chat" name="Chatbot (AI)">
        <bpmn:flowNodeRef>gb1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b2a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gm_e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gb2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b1a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gm_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gm2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gb3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:exclusiveGateway id="gb1" name="Details complete and valid?">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
      <bpmn:incoming>f35</bpmn:incoming>
      <bpmn:outgoing>f36</bpmn:outgoing>
      <bpmn:outgoing>f37</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="b2a" name="Ask for products and quantities">
      <bpmn:documentation>HU 2.9.3</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
      <bpmn:incoming>f36</bpmn:incoming>
      <bpmn:outgoing>f39</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="gm_e2">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
      <bpmn:incoming>f39</bpmn:incoming>
      <bpmn:incoming>f44</bpmn:incoming>
      <bpmn:outgoing>f40</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="b2" name="Validate products (active catalog) and quantities">
      <bpmn:documentation>HU 2.9.3-2.9.5. The catalog has NO prices.</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
      <bpmn:incoming>f41</bpmn:incoming>
      <bpmn:outgoing>f42</bpmn:outgoing>
      <bpmn:property id="Property_0db70h5" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="da13">
        <bpmn:sourceRef>ds_cat1</bpmn:sourceRef>
        <bpmn:targetRef>Property_0db70h5</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gb2" name="Products active and quantities valid?">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
      <bpmn:incoming>f42</bpmn:incoming>
      <bpmn:outgoing>f43</bpmn:outgoing>
      <bpmn:outgoing>f45</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="cs" name="Quote request received">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
      <bpmn:outgoing>f31</bpmn:outgoing>
      <bpmn:messageEventDefinition id="cs_med" />
    </bpmn:startEvent>
    <bpmn:sendTask id="b1a" name="Ask for contact details">
      <bpmn:documentation>HU 2.9.1</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
      <bpmn:incoming>f31</bpmn:incoming>
      <bpmn:outgoing>f32</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="e1" name="Contact details received">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
      <bpmn:incoming>f33</bpmn:incoming>
      <bpmn:outgoing>f34</bpmn:outgoing>
      <bpmn:messageEventDefinition id="e1_med" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="b1" name="Validate contact details">
      <bpmn:documentation>RF-02-06, HU 2.9.1-2.9.2: full name, valid email and phone are mandatory.</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
      <bpmn:incoming>f34</bpmn:incoming>
      <bpmn:outgoing>f35</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="e2" name="Products and quantities received">
      <bpmn:categoryValueRef>CV_G1</bpmn:categoryValueRef>
      <bpmn:incoming>f40</bpmn:incoming>
      <bpmn:outgoing>f41</bpmn:outgoing>
      <bpmn:messageEventDefinition id="e2_med" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="a1" name="Review the preliminary quote and its AI-estimated price ranges">
      <bpmn:documentation>RF-02-13, HU 2.25. The "estimated range" is the min-max price range per product that the chatbot estimated from recent quotes (or WhatsApp history in the initial phase); the Administrador reviews it before setting final prices.</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G2</bpmn:categoryValueRef>
      <bpmn:incoming>f61</bpmn:incoming>
      <bpmn:incoming>f67</bpmn:incoming>
      <bpmn:outgoing>f62</bpmn:outgoing>
      <bpmn:property id="Property_01s3txo" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="da12">
        <bpmn:sourceRef>ds_qr</bpmn:sourceRef>
        <bpmn:targetRef>Property_01s3txo</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ga1" name="Decision?">
      <bpmn:documentation>Approve requires final prices and a dispatch date (RF-02-14). The decision is captured at the review; no extra manual task is needed to confirm it.</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G2</bpmn:categoryValueRef>
      <bpmn:incoming>f62</bpmn:incoming>
      <bpmn:outgoing>f63</bpmn:outgoing>
      <bpmn:outgoing>f64</bpmn:outgoing>
      <bpmn:outgoing>f65</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="a4" name="Enter the rejection reason">
      <bpmn:documentation>RF-02-16, HU 2.29.1-2.29.2: reason is mandatory.</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G2</bpmn:categoryValueRef>
      <bpmn:incoming>f64</bpmn:incoming>
      <bpmn:outgoing>f68</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a2" name="Modify the quote: items, quantities, prices and date">
      <bpmn:documentation>RF-02-15. The unit price is set per quote; there is no official list.</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G2</bpmn:categoryValueRef>
      <bpmn:incoming>f63</bpmn:incoming>
      <bpmn:outgoing>f66</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="s6" name="Set status &#34;Aprobada&#34; and log">
      <bpmn:documentation>RF-02-14, HU 2.27. The approved final prices feed the history of recent prices.</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G2</bpmn:categoryValueRef>
      <bpmn:incoming>f65</bpmn:incoming>
      <bpmn:outgoing>f71</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="da2">
        <bpmn:targetRef>ds2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="pg1">
      <bpmn:categoryValueRef>CV_G2</bpmn:categoryValueRef>
      <bpmn:incoming>f71</bpmn:incoming>
