    <bpmn:userTask id="sr_e_5" name="Select the&#10;customer from the list (filters optional)">
      <bpmn:documentation>RF-02-08: the paginated list is shown by default; filters by NIT/ID, name, commercial contact and status are optional.</bpmn:documentation>
      <bpmn:incoming>f159</bpmn:incoming>
      <bpmn:outgoing>f169</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="em_5">
      <bpmn:incoming>f169</bpmn:incoming>
      <bpmn:incoming>f203</bpmn:incoming>
      <bpmn:outgoing>f170</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ce1x" name="Edit name,&#10;address, phone or email (type and NIT/ID are read-only)">
      <bpmn:documentation>RF-02-11</bpmn:documentation>
      <bpmn:incoming>f170</bpmn:incoming>
      <bpmn:outgoing>f171</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="cd1" name="Confirm&#10;deactivation of the customer">
      <bpmn:documentation>RF-02-12. Logical change, no physical deletion.</bpmn:documentation>
      <bpmn:incoming>f177</bpmn:incoming>
      <bpmn:outgoing>f178</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="sr_c" name="Select the customer from the list (filters optional)">
      <bpmn:documentation>RF-02-08: the paginated list is shown by default; filters by NIT/ID, name, commercial contact and status are optional.</bpmn:documentation>
      <bpmn:incoming>f161</bpmn:incoming>
      <bpmn:outgoing>f180</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ct1" name="Open the unified profile (details, quote/O.T. history and notes)">
      <bpmn:documentation>RF-02-09: consolidated view indexed by NIT or document number.</bpmn:documentation>
      <bpmn:incoming>f180</bpmn:incoming>
      <bpmn:outgoing>f181</bpmn:outgoing>
      <bpmn:property id="Property_06l9bck" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="dac5">
        <bpmn:sourceRef>ds_cur</bpmn:sourceRef>
        <bpmn:targetRef>Property_06l9bck</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gn" name="Manage a note?">
      <bpmn:incoming>f181</bpmn:incoming>
      <bpmn:outgoing>f182</bpmn:outgoing>
      <bpmn:outgoing>f185</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="ct2" name="Manage the customer&#39;s notes (process M2_06)">
      <bpmn:documentation>Called process: M2_06 Customer Notes (HU 2.22-2.24).</bpmn:documentation>
      <bpmn:incoming>f182</bpmn:incoming>
      <bpmn:outgoing>f204</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="s_vr_5" name="Validate fields and NIT/ID uniqueness">
      <bpmn:documentation>RF-02-10: the NIT or document number must not already exist.</bpmn:documentation>
      <bpmn:incoming>f163</bpmn:incoming>
      <bpmn:outgoing>f164</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gv_r_5" name="Data valid and NIT/ID unique?">
      <bpmn:incoming>f164</bpmn:incoming>
      <bpmn:outgoing>f165</bpmn:outgoing>
      <bpmn:outgoing>f167</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="s_sv_5" name="Create the customer as &#34;Activo&#34; and log">
      <bpmn:documentation>RF-02-10</bpmn:documentation>
      <bpmn:incoming>f165</bpmn:incoming>
      <bpmn:outgoing>f166</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="dac1">
        <bpmn:targetRef>ds_cu1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_sv_5" name="Customer registered">
      <bpmn:incoming>f166</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="n_r_5" name="Tell the user&#10;what is missing, invalid or already registered">
      <bpmn:documentation>RF-02-10: for duplicates the system prevents creation and shows that the document is already registered; the user can correct it and retry.</bpmn:documentation>
      <bpmn:incoming>f167</bpmn:incoming>
      <bpmn:outgoing>f200</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="s_ve_5" name="Validate fields">
      <bpmn:documentation>RF-02-11</bpmn:documentation>
      <bpmn:incoming>f171</bpmn:incoming>
      <bpmn:outgoing>f172</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gv_e_5" name="Fields valid?">
      <bpmn:incoming>f172</bpmn:incoming>
      <bpmn:outgoing>f173</bpmn:outgoing>
      <bpmn:outgoing>f175</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="s_ed_5" name="Save changes and log">
      <bpmn:documentation>RF-02-11</bpmn:documentation>
      <bpmn:incoming>f173</bpmn:incoming>
      <bpmn:outgoing>f174</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="dac2">
        <bpmn:targetRef>ds_cu2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_ed_5" name="Customer updated">
      <bpmn:incoming>f174</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="n_e_5" name="Tell the user&#10;which fields are missing or invalid">
      <bpmn:incoming>f175</bpmn:incoming>
      <bpmn:outgoing>f202</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="s_d" name="Set &#34;Inactivo&#34;;&#10;block new quotes/orders and history read-only">
      <bpmn:documentation>RF-02-12</bpmn:documentation>
      <bpmn:incoming>f178</bpmn:incoming>
      <bpmn:outgoing>f179</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="dac3">
        <bpmn:targetRef>ds_cu3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_d" name="Customer deactivated">
      <bpmn:incoming>f179</bpmn:incoming>
    </bpmn:endEvent>
