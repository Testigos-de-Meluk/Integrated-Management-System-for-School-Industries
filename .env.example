# Copy this file to .env (never commit .env). Values below are for LOCAL DEVELOPMENT ONLY.

# --- Django -------------------------------------------------------------------------------------
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- PostgreSQL ---------------------------------------------------------------------------------
POSTGRES_DB=imsi
POSTGRES_USER=imsi
POSTGRES_PASSWORD=imsi_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Port published on your machine (change it if you already run PostgreSQL locally).
POSTGRES_PUBLISHED_PORT=5432

# --- Redis (Celery broker) ----------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Email (Mailpit captures every email in development: http://localhost:8025) ----------------
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=IMSI <no-reply@industriasescolares.local>

# --- Frontend URL used in emails (login link) ---------------------------------------------------
FRONTEND_URL=http://localhost:5173

# --- Authentication -----------------------------------------------------------------------------
# Leave empty in development. In production set long random values (see backend/README.md).
JWT_SIGNING_KEY=
TOTP_ENCRYPTION_KEY=

# --- AI provider (optional) ---------------------------------------------------------------------
# OpenAI-compatible API; OpenRouter by default. Put your own key here, NEVER in Git or in a chat.
# Without a key the AI features are off (prices come from statistics, no free-text option).
# Free models change often: see https://openrouter.ai/models?q=free
# (a cheap paid alternative: deepseek/deepseek-v4.1-flash).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-4-31b-it:free
LLM_TIMEOUT_SECONDS=20
# Only for providers that require a session header. OpenCode Go (subscription, for development
# and the course demo only; its terms are for internal use):
#   LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
#   LLM_MODEL=deepseek-v4.1-flash
#   LLM_SESSION_HEADER=x-opencode-session
# OpenCode Zen (pay-as-you-go, for production; no session header):
#   LLM_BASE_URL=https://opencode.ai/inference/openai/v1
#   LLM_MODEL=deepseek-v4.1-flash
LLM_SESSION_HEADER=
