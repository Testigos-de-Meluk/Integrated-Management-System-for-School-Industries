# Copy this file to .env (never commit .env). Values below are for LOCAL DEVELOPMENT ONLY.

# --- Django -------------------------------------------------------------------------------------
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- PostgreSQL ---------------------------------------------------------------------------------
POSTGRES_DB=imsi
POSTGRES_USER=imsi
POSTGRES_PASSWORD=imsi_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Port published on your machine (change it if you already run PostgreSQL locally).
POSTGRES_PUBLISHED_PORT=5432

# --- Redis (Celery broker) ----------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Email (Mailpit captures every email in development: http://localhost:8025) ----------------
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=IMSI <no-reply@industriasescolares.local>
